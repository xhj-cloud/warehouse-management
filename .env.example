# ============================================
#  仓库管理系统 - 环境变量示例
#  使用方式：复制为 .env 后按注释填写（.env 已被 gitignore，不会提交）
#    cp .env.example .env && vim .env
# ============================================

# ---- 数据库配置 ----
DB_HOST=localhost
DB_PORT=3306
DB_USER=warehouse
# 必填：你的 MySQL 密码。请自行设定强密码（本仓库不内置任何默认密码）
DB_PASSWORD=
DB_NAME=warehouse_db

# ---- LM Studio AI 配置（可选，不影响基础功能）----
LM_STUDIO_URL=http://127.0.0.1:1234/v1
LM_STUDIO_MODEL=lmstudio-community/qwen3.8-27b-q8_0.gguf/qwen3.8-27b-q8_0.gguf

# ---- 登录认证配置 ----
# AUTH_PASSWORD：管理员初始密码。首次启动（users 表为空）时用它创建 admin 账户；
# 留空则自动生成一次性随机强密码并打印到启动日志（仅此一次显示）。
# 设置后同时作为超级管理员兜底凭据，请妥善保管。
AUTH_USER=admin
AUTH_PASSWORD=

# ---- Flask 配置 ----
SECRET_KEY=change-this-to-a-random-string
